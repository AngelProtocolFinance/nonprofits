{
  "name": "@nonprofits/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:reset:local": "node scripts/local-data.ts reset",
    "db:seed:local": "node scripts/local-data.ts seed",
    "db:search-index:local": "node scripts/local-data.ts search-index",
    "db:flip:local": "node scripts/local-data.ts flip",
    "types": "wrangler types --strict-vars=false",
    "auth:generate": "auth generate --config auth.generate.ts --output .wrangler/auth-schema.sql --yes",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/direct && tsc --noEmit -p scripts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "auth": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@nonprofits/core": "workspace:*",
    "@nonprofits/db": "workspace:*",
    "better-auth": "catalog:",
    "zod": "catalog:"
  }
}
