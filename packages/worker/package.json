{
  "name": "@nonprofits/worker",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file fixtures/seed.sql",
    "db:search-index:local": "node --input-type=module -e \"import { rebuildSearchIndexSql } from '@nonprofits/db'; process.stdout.write(rebuildSearchIndexSql(''))\" > .wrangler/search-index.sql && wrangler d1 execute DB --local --file .wrangler/search-index.sql",
    "types": "wrangler types --strict-vars=false",
    "auth:generate": "auth generate --config auth.generate.ts --output .wrangler/auth-schema.sql --yes",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p test/direct"
  },
  "devDependencies": {
    "auth": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@nonprofits/core": "workspace:*",
    "@nonprofits/db": "workspace:*",
    "better-auth": "catalog:"
  }
}
