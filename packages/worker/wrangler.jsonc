{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nonprofits",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "ADMIN_TOKEN"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nonprofits",
      "migrations_dir": "../db/migrations"
    }
  ]
}
