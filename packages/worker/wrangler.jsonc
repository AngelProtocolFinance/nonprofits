{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nonprofits",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  // service-wide requests a UTC day per tier, so neither can lock out the other; whitelisted keys are exempt
  "vars": {
    "SERVICE_KEY_DAILY_LIMIT": 50000,
    "SERVICE_KEYLESS_DAILY_LIMIT": 200000
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "ADMIN_TOKEN", "IP_HASH_SECRET"]
  },
  // prunes key_usage once a UTC day
  "triggers": { "crons": ["17 3 * * *"] },
  // namespace_id is account-wide: another binding with the same id shares its counters
  "ratelimits": [
    {
      "name": "KEY_BURST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "KEYLESS_BURST_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 }
    },
    {
      // every request carrying a key, per client, before the key is read: above any
      // whitelisted key's honest per-minute traffic, below a bad-key flood
      "name": "KEYED_REQUEST_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      // HTTP requests to /mcp without a key, per client, whatever messages each
      // carries: handshakes and tool listings aren't metered, so this bounds
      // them; well above a keyless session's few
      "name": "KEYLESS_MCP_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nonprofits",
      "migrations_dir": "../db/migrations"
    }
  ]
}
