# Every variable the deployed api reads. Set them in the Vercel project
# (Settings > Environment Variables), scoped to Production, then redeploy.
# Values here are placeholders: until each needed var is set to a real value
# the app answers every request with a 503 naming the rest. Secrets are at
# least 32 characters.

# Turso app database: auth, usage counters, the served-database pointer.
# `turso db show <app-db> --url`, and `turso db tokens create <app-db>` (read-write).
TURSO_APP_DB_URL=replace-with-libsql-url-of-the-app-database
TURSO_APP_DB_TOKEN=replace-with-app-database-read-write-token
# Read-only token for every data database in the group, so next month's needs no new one:
# `turso group tokens create <group> --read-only`.
TURSO_DATA_DB_TOKEN=replace-with-group-read-only-token

# Generate each with `openssl rand -base64 32`.
# Keys the hash that stands in for a client's IP in the usage counters.
IP_HASH_SECRET=replace-with-ip-hash-secret
# better-auth's signing secret for API keys.
BETTER_AUTH_SECRET=replace-with-better-auth-secret
# The bearer token the key CLI sends to /admin.
ADMIN_TOKEN=replace-with-admin-token
# Vercel's cron sends it as `Authorization: Bearer <CRON_SECRET>` to /cron/daily.
CRON_SECRET=replace-with-cron-secret

# A fine-grained GitHub token on GITHUB_REPO with Actions: read and write, so
# the daily cron can start the import workflow when the served data goes stale.
GITHUB_DISPATCH_TOKEN=replace-with-github-token

# Optional: leave empty for the default.
# owner/repo holding .github/workflows/import.yml; defaults to the GitHub
# repository Vercel deployed from, else FRESHNESS_DEFAULTS in src/freshness.ts.
GITHUB_REPO=
# Days after a switch that the served data is stale, and hours between
# dispatches; defaults in FRESHNESS_DEFAULTS (src/freshness.ts).
STALE_AFTER_DAYS=
REDISPATCH_AFTER_HOURS=
# Requests a UTC day across all keyless callers, and across all default-tier
# keys; default DEFAULT_SERVICE_DAILY_LIMIT (src/quota.ts).
SERVICE_KEYLESS_DAILY_LIMIT=
SERVICE_KEY_DAILY_LIMIT=
# Salts the keys @vercel/firewall sends to the Firewall's rate-limit rules.
RATE_LIMIT_SECRET=
